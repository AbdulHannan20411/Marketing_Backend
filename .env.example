# Copy to .env and fill in. .env is gitignored and excluded from the Docker
# build context; this file carries no real values and is safe to commit.
#
#   cp .env.example .env
#
# Compose reads .env automatically. Nothing here is baked into an image - every
# value is supplied to the running container, so rotating a secret is a restart
# rather than a rebuild.

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=marketing
POSTGRES_USER=marketing

# CHANGE THIS. Generate one rather than inventing one:
#   openssl rand -base64 32
POSTGRES_PASSWORD=replace_me_before_first_run

# Host port only. Inside the compose network the database is always reached as
# postgres:5432, whatever this is set to. Change it when 5432 is already taken
# on your machine; in production, consider removing the published port entirely
# so the database is reachable only from the compose network.
POSTGRES_PORT=5432

# ─────────────────────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────────────────────
# Development enables Swagger, detailed errors, and applies migrations and the
# seed on startup. Production does none of those - see the migration note in the
# README section of the answer that produced this file.
ASPNETCORE_ENVIRONMENT=Production

# Host port. The container always listens on 8080.
API_PORT=8080

# Whether the API applies pending EF Core migrations as it starts.
#
# true is convenient and is what appsettings.Development.json already does.
# false is the safer production posture: with more than one replica, several
# instances race to migrate the same database at once, and a schema change then
# lands while the previous version is still serving traffic. Run migrations as a
# deliberate step instead - the commands are in the answer.
APPLY_MIGRATIONS_ON_STARTUP=false

# Creates the first administrator when the database is empty. Leave SEED_ON_STARTUP
# false in production once that account exists.
SEED_ON_STARTUP=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Authentication — REQUIRED, the API will not start without these
# ─────────────────────────────────────────────────────────────────────────────
# At least 32 characters. Changing it invalidates every token in circulation,
# which signs everybody out - deliberate, but not something to do casually.
#   openssl rand -base64 48
JWT_SIGNING_KEY=replace_me_at_least_32_characters_long
JWT_ISSUER=https://api.your-domain.com
JWT_AUDIENCE=https://app.your-domain.com

# ─────────────────────────────────────────────────────────────────────────────
# Redis and RabbitMQ
# ─────────────────────────────────────────────────────────────────────────────
# Both are reached by compose service name. Redis is a cache: if it is
# unavailable the application degrades rather than failing. RabbitMQ starts
# without blocking the API.
REDIS_ENABLED=true
RABBITMQ_ENABLED=true
RABBITMQ_USER=marketing
RABBITMQ_PASSWORD=replace_me_before_first_run
RABBITMQ_MANAGEMENT_PORT=15672

# ─────────────────────────────────────────────────────────────────────────────
# Outbound integrations — optional; each feature is off until its key is set
# ─────────────────────────────────────────────────────────────────────────────
# Meta WhatsApp Cloud API.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Google Places, for business discovery. Unset means the feature reports itself
# unavailable rather than failing.
PLACES_API_KEY=

# SMTP, for invitations and expiry reminders.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=

# Where the client is served from. Used in email links and CORS.
CLIENT_BASE_URL=https://app.your-domain.com
