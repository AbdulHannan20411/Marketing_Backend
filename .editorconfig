root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,xml}]
indent_size = 2

[*.cs]
# --- Language conventions -------------------------------------------------
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:error
csharp_prefer_braces = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion

dotnet_style_readonly_field = true:error
# "always" also covers interface members, which are implicitly public. Verbose, but the rule is
# all-or-nothing: the analyzer reports explicit modifiers as *unnecessary* under the alternative,
# so a mixed codebase cannot compile warning-free either way. Consistency wins.
dotnet_style_require_accessibility_modifiers = always:error
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# --- Naming ---------------------------------------------------------------
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_style
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.severity = error
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

dotnet_naming_rule.types_pascal_case.severity = error
dotnet_naming_rule.types_pascal_case.symbols = type_symbol
dotnet_naming_rule.types_pascal_case.style = pascal_style
dotnet_naming_symbols.type_symbol.applicable_kinds = class,struct,interface,enum,delegate,method,property,event
dotnet_naming_style.pascal_style.capitalization = pascal_case

# --- Analyzer severities --------------------------------------------------
dotnet_diagnostic.CA1062.severity = none      # null checks handled by nullable reference types
dotnet_diagnostic.CA2007.severity = none      # ConfigureAwait not required in ASP.NET Core
dotnet_diagnostic.CA1848.severity = none      # LoggerMessage source-gen not enforced everywhere
dotnet_diagnostic.IDE0290.severity = suggestion
dotnet_diagnostic.CA1515.severity = none      # public types are intentional across layers
# CA1716 flags "Shared" and "Scheduler" namespace segments because they collide with reserved
# words in other .NET languages (VB's Shared). Nothing consumes this solution from VB, and the
# names describe the layers accurately, so the interop concern does not apply.
dotnet_diagnostic.CA1716.severity = none

[tests/**/*.cs]
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CA1707.severity = none      # underscores in test method names are idiomatic
