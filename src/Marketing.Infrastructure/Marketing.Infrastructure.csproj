<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure: everything that talks to something outside the process.
    Redis, Serilog, Polly, Refit/Meta Cloud API, JWT issuance and the system clock.
    Background scheduling deliberately lives in Marketing.Scheduler, not here.
  -->
  <PropertyGroup>
    <RootNamespace>Marketing.Infrastructure</RootNamespace>
    <AssemblyName>Marketing.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marketing.Common\Marketing.Common.csproj" />
    <ProjectReference Include="..\Marketing.Shared\Marketing.Shared.csproj" />
    <ProjectReference Include="..\Marketing.Application\Marketing.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Brings in the ASP.NET Core shared framework, which already supplies HttpClientFactory,
      the options binder, the data-protection key derivation primitives and IHttpContextAccessor.
      Referencing those as packages as well would be redundant and is rejected by NU1510.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Polly.Extensions" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Refit" />
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
