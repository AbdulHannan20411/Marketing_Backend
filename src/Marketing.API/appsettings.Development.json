{
  "//": [
    "DEVELOPMENT ONLY.",
    "The values below target the local docker-compose stack and are intentionally worthless:",
    "they protect nothing and must never be reused in a shared environment.",
    "For anything beyond a developer machine, supply Database:ConnectionString,",
    "Authentication:Jwt:SigningKey, WhatsApp:AppSecret and the Bootstrap credentials from",
    "user secrets or the platform secret store, and leave them empty here."
  ],

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },

  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=marketing;Username=postgres;Password=Honey@123;Include Error Detail=true;Maximum Pool Size=50",
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": true,
    "ApplyMigrationsOnStartup": true,
    "SeedOnStartup": true
  },

  "Redis": {
    "ConnectionString": "localhost:6379",
    "Enabled": true
  },

  "Authentication": {
    "Jwt": {
      "Issuer": "https://localhost:7108",
      "Audience": "marketing-spa-dev",
      "SigningKey": "DEVELOPMENT-ONLY-SIGNING-KEY-DO-NOT-REUSE-1f4c9a2b7e6d",
      "AccessTokenLifetimeMinutes": 60
    },
    "PasswordHashing": {
      "Iterations": 100000
    }
  },

  "WhatsApp": {
    "AppId": "000000000000000",
    "AppSecret": "development-app-secret-placeholder",
    "WebhookVerifyToken": "development-verify-token"
  },

  "Security": {
    "//": "A fixed, published development key. It is worthless by design - anything encrypted with it is readable by anyone holding this file.",
    "EncryptionKeys": {
      "dev": "ZGV2ZWxvcG1lbnQtb25seS1hZXMyNTYta2V5LTMyYnk="
    },
    "ActiveKeyId": "dev"
  },

  "Email": {
    "ClientBaseUrl": "http://localhost:4200"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200" ]
  },

  "Bootstrap": {
    "AdministratorEmail": "Honey@yopmail.com",
    "AdministratorPassword": "Honey@123"
  }
}
