{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Quartz": "Information"
      }
    }
  },

  "Database": {
    "ConnectionString": "",
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 10,
    "CommandTimeoutSeconds": 30,
    "SlowQueryThresholdMilliseconds": 500,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false,
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false
  },

  "ConnectionStrings": {
    "//": "Supplied per environment from user secrets, environment variables or the secret store.",
    "Redis": "",
    "RabbitMq": ""
  },

  "Redis": {
    "ConnectionString": "127.0.0.1:6379",
    "Enabled": true,
    "DefaultExpirationSeconds": 300,
    "OperationTimeoutMilliseconds": 2000,
    "CircuitResetSeconds": 30
  },

  "RabbitMQ": {
    "//": "Replace the host and credentials per environment. guest/guest is loopback-only.",
    "Host": "127.0.0.1",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Enabled": true,
    "ConnectionTimeoutSeconds": 10,
    "RequestedHeartbeatSeconds": 60,
    "AutomaticRecoveryEnabled": true,
    "TopologyRecoveryEnabled": true,
    "NetworkRecoveryIntervalSeconds": 5,
    "ClientProvidedName": "Marketing.API"
  },

  "Authentication": {
    "Jwt": {
      "Issuer": "https://api.marketing-platform.io",
      "Audience": "marketing-spa",
      "SigningKey": "",
      "AccessTokenLifetimeMinutes": 15,
      "RefreshTokenLifetimeDays": 14,
      "ClockSkewSeconds": 0
    },
    "PasswordHashing": {
      "Iterations": 210000
    },
    "Policy": {
      "MaxFailedLoginAttempts": 5,
      "LockoutDurationMinutes": 15,
      "MinimumPasswordLength": 12,
      "MaxConcurrentSessions": 5
    }
  },

  "Smtp": {
    "//": "Delivery is enabled by Host alone. Leave it empty and messages are recorded instead of sent. Password comes from user secrets or the platform secret store - never from this file.",
    "Host": "",
    "Port": 587,
    "UseImplicitTls": false,
    "UserName": "",
    "Password": "",
    "TimeoutSeconds": 30
  },

  "Security": {
    "//": "Base64 AES-256 keys, 32 bytes each. Supplied from the secret store - never committed. Keep a retired key here until every ciphertext has been re-wrapped under the active one.",
    "EncryptionKeys": {},
    "ActiveKeyId": "k1"
  },

  "Email": {
    "FromAddress": "no-reply@marketing-platform.io",
    "FromName": "Marketing Platform",
    "//": "ClientBaseUrl builds invitation and reset links. Never derived from the request Host header - that is a host-header injection.",
    "ClientBaseUrl": "",
    "InvitationLifetimeHours": 72,
    "PasswordResetLifetimeHours": 1
  },

  "Storage": {
    "RootPath": "App_Data/storage"
  },

  "Imports": {
    "MaxFileSizeBytes": 26214400,
    "MaxRows": 50000,
    "CommitChunkSize": 500,
    "PollBatchSize": 5,
    "MaxAttempts": 5,
    "LeaseMinutes": 30
  },

  "Scheduler": {
    "Enabled": true,
    "WaitForJobsToComplete": true,
    "MaxConcurrency": 10,
    "//": "Per-job overrides keyed by the [ScheduledJob] Key. Omitted jobs use their attribute defaults.",
    "Jobs": {
      "refresh-token-cleanup": {
        "Enabled": true,
        "Cron": "0 15 3 * * ?"
      },
      "campaign-dispatch": {
        "Enabled": true,
        "Cron": "0 * * * * ?"
      },
      "import-jobs": {
        "Enabled": true,
        "Cron": "0/15 * * * * ?"
      }
    }
  },

  "Resilience": {
    "RetryCount": 3,
    "BaseDelayMilliseconds": 500,
    "AttemptTimeoutSeconds": 10,
    "TotalTimeoutSeconds": 60,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerSamplingSeconds": 30,
    "CircuitBreakerMinimumThroughput": 10,
    "CircuitBreakerBreakSeconds": 30,
    "MaxConcurrentCalls": 100
  },

  "WhatsApp": {
    "BaseUrl": "https://graph.facebook.com",
    "ApiVersion": "v21.0",
    "AppId": "",
    "AppSecret": "",
    "ConfigId": "",
    "WebhookVerifyToken": "",
    "RequestTimeoutSeconds": 30
  },

  "Cors": {
    "AllowedOrigins": [ "https://app.marketing-platform.io" ],
    "PreflightMaxAgeSeconds": 3600
  },

  "Bootstrap": {
    "AdministratorEmail": "",
    "AdministratorPassword": ""
  },

  "AllowedHosts": "*"
}
