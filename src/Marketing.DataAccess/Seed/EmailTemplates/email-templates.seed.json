{
  "version": 1,
  "templates": [
    {
      "key": "layout.base",
      "name": "Base layout",
      "description": "The branded wrapper every email is rendered inside: header, card and footer.",
      "category": "layout",
      "subject": "{{subject}}",
      "htmlBody": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"x-apple-disable-message-reformatting\">\n  <meta name=\"color-scheme\" content=\"light\">\n  <meta name=\"supported-color-schemes\" content=\"light\">\n  <title>{{subject}}</title>\n  <style>\n    @media only screen and (max-width: 620px) {\n      .email-container { width: 100% !important; }\n      .email-card { padding: 28px 22px !important; }\n    }\n  </style>\n</head>\n<body style=\"margin:0;padding:0;background-color:#f6fff8;\">\n  {{#if preheader}}<div style=\"display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all;font-size:1px;line-height:1px;color:#f6fff8;\">{{preheader}}</div>{{/if}}\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f6fff8;\">\n    <tr>\n      <td align=\"center\" style=\"padding:32px 16px;\">\n        <table role=\"presentation\" class=\"email-container\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:600px;max-width:600px;\">\n\n          <!-- Brand mark, matching the sidebar: initial on brand green, then the name -->\n          <tr>\n            <td style=\"padding:0 4px 20px 4px;\">\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                  <td width=\"36\" height=\"36\" align=\"center\" valign=\"middle\" bgcolor=\"#16a34a\" style=\"width:36px;height:36px;border-radius:10px;background-color:#16a34a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:36px;font-weight:700;color:#ffffff;\">{{appInitial}}</td>\n                  <td style=\"padding-left:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;font-weight:600;letter-spacing:-0.2px;color:#1e293b;\">{{appName}}</td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Card -->\n          <tr>\n            <td class=\"email-card\" style=\"padding:36px 40px;background-color:#ffffff;border:1px solid #e5e7eb;border-radius:12px;\">\n{{{content}}}\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td align=\"center\" style=\"padding:24px 16px 0 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#6b7280;\">\n              Need help? Write to <a href=\"mailto:{{supportEmail}}\" style=\"color:#15803d;text-decoration:underline;\">{{supportEmail}}</a>.<br>\n              &copy; {{year}} {{appName}}\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n",
      "textBody": "{{appName}}\n\n{{{content}}}\n\n---\nNeed help? Write to {{supportEmail}}.\n(c) {{year}} {{appName}}\n",
      "variables": []
    },
    {
      "key": "auth.welcome",
      "name": "Welcome",
      "description": "Sent once a new workspace owner has finished signing up.",
      "category": "account",
      "subject": "Welcome to {{appName}}, {{name}}",
      "htmlBody": "<h1 style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:22px;line-height:30px;font-weight:700;letter-spacing:-0.3px;color:#1e293b;\">\n  Welcome aboard, {{name}}\n</h1>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  Your workspace <strong style=\"font-weight:600;color:#1e293b;\">{{workspaceName}}</strong> is ready. Three steps take you from here to your first campaign:\n</p>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:8px 0 16px 0;\">\n  <tr>\n    <td width=\"40\" valign=\"top\" style=\"padding:0 0 16px 0;\">\n      <div style=\"width:28px;height:28px;border-radius:14px;background-color:#f0fdf4;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:28px;font-weight:700;text-align:center;color:#15803d;\">1</div>\n    </td>\n    <td valign=\"top\" style=\"padding:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\">\n      <p style=\"margin:0;font-size:15px;line-height:22px;font-weight:600;color:#1e293b;\">Connect WhatsApp</p>\n      <p style=\"margin:2px 0 0 0;font-size:14px;line-height:21px;color:#475569;\">Link your WhatsApp Business number so messages go out under your name.</p>\n    </td>\n  </tr>\n  <tr>\n    <td width=\"40\" valign=\"top\" style=\"padding:0 0 16px 0;\">\n      <div style=\"width:28px;height:28px;border-radius:14px;background-color:#f0fdf4;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:28px;font-weight:700;text-align:center;color:#15803d;\">2</div>\n    </td>\n    <td valign=\"top\" style=\"padding:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\">\n      <p style=\"margin:0;font-size:15px;line-height:22px;font-weight:600;color:#1e293b;\">Import your contacts</p>\n      <p style=\"margin:2px 0 0 0;font-size:14px;line-height:21px;color:#475569;\">Upload a spreadsheet. Numbers are checked before anything is saved.</p>\n    </td>\n  </tr>\n  <tr>\n    <td width=\"40\" valign=\"top\" style=\"padding:0 0 16px 0;\">\n      <div style=\"width:28px;height:28px;border-radius:14px;background-color:#f0fdf4;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:28px;font-weight:700;text-align:center;color:#15803d;\">3</div>\n    </td>\n    <td valign=\"top\" style=\"padding:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\">\n      <p style=\"margin:0;font-size:15px;line-height:22px;font-weight:600;color:#1e293b;\">Send your first campaign</p>\n      <p style=\"margin:2px 0 0 0;font-size:14px;line-height:21px;color:#475569;\">Pick an approved template, choose an audience, then send now or schedule it.</p>\n    </td>\n  </tr>\n</table>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:8px 0 24px 0;\">\n  <tr>\n    <td align=\"center\" bgcolor=\"#16a34a\" style=\"border-radius:8px;background-color:#16a34a;\">\n      <a href=\"{{actionUrl}}\" target=\"_blank\" style=\"display:inline-block;padding:13px 26px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;\">Open your dashboard</a>\n    </td>\n  </tr>\n</table>\n\n<p style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">\n  Button not working? Copy this link into your browser:<br>\n  <a href=\"{{actionUrl}}\" target=\"_blank\" style=\"color:#15803d;text-decoration:underline;word-break:break-all;\">{{actionUrl}}</a>\n</p>\n",
      "textBody": "Welcome aboard, {{name}}\n\nYour workspace \"{{workspaceName}}\" is ready. Three steps take you to your first campaign:\n\n1. Connect WhatsApp: link your WhatsApp Business number so messages go out under your name.\n2. Import your contacts: upload a spreadsheet. Numbers are checked before anything is saved.\n3. Send your first campaign: pick an approved template, choose an audience, then send now or schedule it.\n\nOpen your dashboard:\n{{actionUrl}}\n",
      "variables": [
        {
          "name": "name",
          "description": "Recipient's name.",
          "sample": "Ayesha Khan"
        },
        {
          "name": "workspaceName",
          "description": "The new workspace.",
          "sample": "Northwind Retail"
        },
        {
          "name": "actionUrl",
          "description": "Link to the dashboard.",
          "sample": "https://app.nextreach.io/dashboard"
        }
      ]
    },
    {
      "key": "auth.invitation",
      "name": "Invitation",
      "description": "Sent when someone is invited to a workspace. Leads to setting a password.",
      "category": "account",
      "subject": "{{#if inviterName}}{{inviterName}} invited you to join {{workspaceName}} on {{appName}}{{else}}You're invited to join {{workspaceName}} on {{appName}}{{/if}}",
      "htmlBody": "<h1 style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:22px;line-height:30px;font-weight:700;letter-spacing:-0.3px;color:#1e293b;\">\n  Join {{workspaceName}}\n</h1>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  Hi {{name}},\n</p>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  {{#if inviterName}}<strong style=\"font-weight:600;color:#1e293b;\">{{inviterName}}</strong> has invited you{{else}}You've been invited{{/if}} to work in <strong style=\"font-weight:600;color:#1e293b;\">{{workspaceName}}</strong> on {{appName}}. Set your password to get started.\n</p>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:8px 0 24px 0;\">\n  <tr>\n    <td align=\"center\" bgcolor=\"#16a34a\" style=\"border-radius:8px;background-color:#16a34a;\">\n      <a href=\"{{actionUrl}}\" target=\"_blank\" style=\"display:inline-block;padding:13px 26px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;\">Accept invitation</a>\n    </td>\n  </tr>\n</table>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">\n  This link works once and expires in {{expiresInHours}} hours.\n</p>\n\n<p style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">\n  Button not working? Copy this link into your browser:<br>\n  <a href=\"{{actionUrl}}\" target=\"_blank\" style=\"color:#15803d;text-decoration:underline;word-break:break-all;\">{{actionUrl}}</a>\n</p>\n\n<hr style=\"border:0;border-top:1px solid #e5e7eb;margin:24px 0;\">\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">\n  {{#if inviterEmail}}This invitation was sent by {{inviterName}} ({{inviterEmail}}) through {{appName}}. Replies go to them. {{/if}}Weren't expecting this? You can safely ignore this email. The link expires on its own.\n</p>\n",
      "textBody": "Hi {{name}},\n\n{{#if inviterName}}{{inviterName}} has invited you{{else}}You've been invited{{/if}} to work in \"{{workspaceName}}\" on {{appName}}. Set your password to get started:\n\n{{actionUrl}}\n\nThis link works once and expires in {{expiresInHours}} hours.\n\n{{#if inviterEmail}}This invitation was sent by {{inviterName}} ({{inviterEmail}}) through {{appName}}. Replies go to them.\n{{/if}}Weren't expecting this? You can safely ignore this email. The link expires on its own.\n",
      "variables": [
        {
          "name": "name",
          "description": "Recipient's name.",
          "sample": "Ayesha Khan"
        },
        {
          "name": "inviterName",
          "description": "Who sent the invitation. Optional: blank when a platform administrator created the account.",
          "sample": "Amara Chen"
        },
        {
          "name": "inviterEmail",
          "description": "Address of whoever sent it, shown so the recipient can check the invitation is genuine. Optional, blank with inviterName.",
          "sample": "amara.chen@northwind.example"
        },
        {
          "name": "workspaceName",
          "description": "Workspace they are joining.",
          "sample": "Northwind Retail"
        },
        {
          "name": "actionUrl",
          "description": "Link to set a password.",
          "sample": "https://app.nextreach.io/auth/accept-invitation?token=sample"
        },
        {
          "name": "expiresInHours",
          "description": "Hours until the link expires.",
          "sample": "72"
        }
      ]
    },
    {
      "key": "auth.password_reset",
      "name": "Password reset",
      "description": "Sent when someone asks to reset a forgotten password.",
      "category": "account",
      "subject": "Reset your {{appName}} password",
      "htmlBody": "<h1 style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:22px;line-height:30px;font-weight:700;letter-spacing:-0.3px;color:#1e293b;\">\n  Reset your password\n</h1>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  Hi {{name}},\n</p>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  We received a request to reset the password on your account. Choose a new one with the button below.\n</p>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:8px 0 24px 0;\">\n  <tr>\n    <td align=\"center\" bgcolor=\"#16a34a\" style=\"border-radius:8px;background-color:#16a34a;\">\n      <a href=\"{{actionUrl}}\" target=\"_blank\" style=\"display:inline-block;padding:13px 26px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;\">Choose a new password</a>\n    </td>\n  </tr>\n</table>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">\n  For your security, this link works once and expires in {{expiresInHours}} hour(s).\n</p>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:4px 0 24px 0;\">\n  <tr>\n    <td style=\"padding:14px 16px;background-color:#fffbeb;border:1px solid #fde68a;border-radius:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;color:#92400e;\">\n      <strong>Didn't ask for this?</strong> Ignore this email and your password stays the same. If these keep arriving, write to {{supportEmail}}.\n    </td>\n  </tr>\n</table>\n\n<p style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">\n  Button not working? Copy this link into your browser:<br>\n  <a href=\"{{actionUrl}}\" target=\"_blank\" style=\"color:#15803d;text-decoration:underline;word-break:break-all;\">{{actionUrl}}</a>\n</p>\n",
      "textBody": "Hi {{name}},\n\nWe received a request to reset the password on your account. Choose a new one here:\n\n{{actionUrl}}\n\nFor your security, this link works once and expires in {{expiresInHours}} hour(s).\n\nDidn't ask for this? Ignore this email and your password stays the same. If these keep arriving, write to {{supportEmail}}.\n",
      "variables": [
        {
          "name": "name",
          "description": "Recipient's name.",
          "sample": "Ayesha Khan"
        },
        {
          "name": "actionUrl",
          "description": "Link to choose a new password.",
          "sample": "https://app.nextreach.io/auth/reset-password?token=sample"
        },
        {
          "name": "expiresInHours",
          "description": "Hours until the link expires.",
          "sample": "1"
        }
      ]
    },
    {
      "key": "auth.email_changed",
      "name": "Email address changed",
      "description": "A security notice sent when the email address on an account changes.",
      "category": "account",
      "subject": "Your {{appName}} email address was changed",
      "htmlBody": "<h1 style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:22px;line-height:30px;font-weight:700;letter-spacing:-0.3px;color:#1e293b;\">\n  Your email address was changed\n</h1>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  Hi {{name}},\n</p>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  The email address on your {{appName}} account is now <strong style=\"font-weight:600;color:#1e293b;\">{{newEmail}}</strong>. We're letting you know in case this wasn't you.\n</p>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:4px 0 24px 0;\">\n  <tr>\n    <td style=\"padding:14px 16px;background-color:#fef2f2;border:1px solid #fecaca;border-radius:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;color:#991b1b;\">\n      <strong>Wasn't you?</strong> Write to <a href=\"mailto:{{supportEmail}}\" style=\"color:#991b1b;text-decoration:underline;\">{{supportEmail}}</a> straight away. Whoever controls the new address can reset your password.\n    </td>\n  </tr>\n</table>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">\n  If you made this change, there's nothing else to do.\n</p>\n",
      "textBody": "Hi {{name}},\n\nThe email address on your {{appName}} account is now {{newEmail}}. We're letting you know in case this wasn't you.\n\nWasn't you? Write to {{supportEmail}} straight away. Whoever controls the new address can reset your password.\n\nIf you made this change, there's nothing else to do.\n",
      "variables": [
        {
          "name": "name",
          "description": "Recipient's name.",
          "sample": "Ayesha Khan"
        },
        {
          "name": "newEmail",
          "description": "The address the account now uses.",
          "sample": "ayesha.khan@northwind.example"
        }
      ]
    },
    {
      "key": "security.new_login",
      "name": "New sign-in",
      "description": "Sent when an account signs in from a device it has not used before, with a way to end that session.",
      "category": "account",
      "subject": "New sign-in to your {{appName}} account",
      "htmlBody": "<h1 style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:22px;line-height:30px;font-weight:700;letter-spacing:-0.3px;color:#1e293b;\">\n  New sign-in to your account\n</h1>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  Hi {{name}},\n</p>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  Your {{appName}} account was just signed in to from a device it hasn't used before.\n</p>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:4px 0 20px 0;border:1px solid #e5e7eb;border-radius:10px;\">\n  <tr>\n    <td style=\"padding:12px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;color:#475569;\">\n      <strong style=\"font-weight:600;color:#1e293b;\">Device:</strong> {{device}}<br>\n      {{#if location}}<strong style=\"font-weight:600;color:#1e293b;\">Location:</strong> {{location}}<br>{{/if}}\n      <strong style=\"font-weight:600;color:#1e293b;\">IP address:</strong> {{ipAddress}}<br>\n      <strong style=\"font-weight:600;color:#1e293b;\">Time:</strong> {{signedInAt}}\n    </td>\n  </tr>\n</table>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:4px 0 24px 0;\">\n  <tr>\n    <td style=\"padding:14px 16px;background-color:#fef2f2;border:1px solid #fecaca;border-radius:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;color:#991b1b;\">\n      <strong>This wasn't you?</strong> <a href=\"{{actionUrl}}\" style=\"color:#991b1b;text-decoration:underline;\">End that session</a> and change your password straight away. Anyone who has your password can see your customers and send messages as your business.\n    </td>\n  </tr>\n</table>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">\n  If this was you, there's nothing else to do. Your account can only be signed in on one device at a time, so any other session was signed out.\n</p>\n",
      "textBody": "Hi {{name}},\n\nYour {{appName}} account was just signed in to from a device it hasn't used before.\n\nDevice: {{device}}\n{{#if location}}Location: {{location}}\n{{/if}}IP address: {{ipAddress}}\nTime: {{signedInAt}}\n\nThis wasn't you? End that session and change your password straight away: {{actionUrl}}\n\nIf this was you, there's nothing else to do. Your account can only be signed in on one device at a time, so any other session was signed out.\n",
      "variables": [
        {
          "name": "name",
          "description": "Recipient's name.",
          "sample": "Ahmed Raza"
        },
        {
          "name": "device",
          "description": "Browser and operating system, such as \"Chrome / Windows\".",
          "sample": "Chrome / Windows"
        },
        {
          "name": "ipAddress",
          "description": "Address the sign-in came from.",
          "sample": "39.45.12.8"
        },
        {
          "name": "location",
          "description": "City and country, when known. Optional: blank when the network did not report one.",
          "sample": "Lahore, PK"
        },
        {
          "name": "signedInAt",
          "description": "When it happened, in UTC.",
          "sample": "18 September 2026, 14:31 UTC"
        },
        {
          "name": "actionUrl",
          "description": "Link to the page listing the account's sessions, where one can be ended.",
          "sample": "https://app.nextreach.io/account/security"
        }
      ]
    },
    {
      "key": "billing.subscription_expiring",
      "name": "Plan expiring",
      "description": "Reminder sent to workspace administrators before their plan ends.",
      "category": "billing",
      "subject": "Your {{planName}} plan expires {{expiresIn}}",
      "htmlBody": "<h1 style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:22px;line-height:30px;font-weight:700;letter-spacing:-0.3px;color:#1e293b;\">\n  Your plan expires {{expiresIn}}\n</h1>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  Hi {{name}},\n</p>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  Your <strong style=\"font-weight:600;color:#1e293b;\">{{planName}}</strong> plan ends on <strong style=\"font-weight:600;color:#1e293b;\">{{expiresOn}}</strong>. Renew before then to keep everything running.\n</p>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:4px 0 24px 0;background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;border-collapse:separate;\">\n  <tr>\n    <td style=\"padding:12px 16px;border-bottom:1px solid #e5e7eb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">Plan</td>\n    <td align=\"right\" style=\"padding:12px 16px;border-bottom:1px solid #e5e7eb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:600;color:#1e293b;\">{{planName}}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:12px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">Ends on</td>\n    <td align=\"right\" style=\"padding:12px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:600;color:#1e293b;\">{{expiresOn}}</td>\n  </tr>\n</table>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:4px 0 24px 0;\">\n  <tr>\n    <td style=\"padding:14px 16px;background-color:#fffbeb;border:1px solid #fde68a;border-radius:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;color:#92400e;\">\n      When the plan ends, scheduled campaigns stop sending until it's renewed.\n    </td>\n  </tr>\n</table>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:8px 0 24px 0;\">\n  <tr>\n    <td align=\"center\" bgcolor=\"#16a34a\" style=\"border-radius:8px;background-color:#16a34a;\">\n      <a href=\"{{actionUrl}}\" target=\"_blank\" style=\"display:inline-block;padding:13px 26px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;\">Renew your plan</a>\n    </td>\n  </tr>\n</table>\n\n<p style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">\n  Button not working? Copy this link into your browser:<br>\n  <a href=\"{{actionUrl}}\" target=\"_blank\" style=\"color:#15803d;text-decoration:underline;word-break:break-all;\">{{actionUrl}}</a>\n</p>\n",
      "textBody": "Hi {{name}},\n\nYour {{planName}} plan ends on {{expiresOn}}. Renew before then to keep everything running.\n\nWhen the plan ends, scheduled campaigns stop sending until it's renewed.\n\nRenew your plan:\n{{actionUrl}}\n",
      "variables": [
        {
          "name": "name",
          "description": "Recipient's name.",
          "sample": "Ayesha Khan"
        },
        {
          "name": "planName",
          "description": "The plan that is ending.",
          "sample": "Growth"
        },
        {
          "name": "expiresIn",
          "description": "Relative wording, e.g. \"in 7 days\" or \"tomorrow\".",
          "sample": "in 7 days"
        },
        {
          "name": "expiresOn",
          "description": "The date it ends, already formatted.",
          "sample": "21 September 2026"
        },
        {
          "name": "actionUrl",
          "description": "Link to renew.",
          "sample": "https://app.nextreach.io/subscription"
        }
      ]
    },
    {
      "key": "payments.submitted",
      "name": "Payment submitted",
      "description": "Sent to platform administrators when a workspace submits proof of payment.",
      "category": "payments",
      "subject": "Payment to review: {{organisation}}",
      "htmlBody": "<h1 style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:22px;line-height:30px;font-weight:700;letter-spacing:-0.3px;color:#1e293b;\">\n  A payment is waiting for review\n</h1>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  Hi {{name}},\n</p>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  <strong style=\"font-weight:600;color:#1e293b;\">{{organisation}}</strong> submitted proof of payment. Their plan changes only once it's approved.\n</p>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:4px 0 24px 0;background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;border-collapse:separate;\">\n  <tr>\n    <td style=\"padding:12px 16px;border-bottom:1px solid #e5e7eb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">Workspace</td>\n    <td align=\"right\" style=\"padding:12px 16px;border-bottom:1px solid #e5e7eb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:600;color:#1e293b;\">{{organisation}}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:12px 16px;border-bottom:1px solid #e5e7eb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">Plan</td>\n    <td align=\"right\" style=\"padding:12px 16px;border-bottom:1px solid #e5e7eb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:600;color:#1e293b;\">{{planName}}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:12px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">Amount</td>\n    <td align=\"right\" style=\"padding:12px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:600;color:#1e293b;\">{{amount}}</td>\n  </tr>\n</table>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:8px 0 24px 0;\">\n  <tr>\n    <td align=\"center\" bgcolor=\"#16a34a\" style=\"border-radius:8px;background-color:#16a34a;\">\n      <a href=\"{{actionUrl}}\" target=\"_blank\" style=\"display:inline-block;padding:13px 26px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;\">Review payment</a>\n    </td>\n  </tr>\n</table>\n\n<p style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">\n  Button not working? Copy this link into your browser:<br>\n  <a href=\"{{actionUrl}}\" target=\"_blank\" style=\"color:#15803d;text-decoration:underline;word-break:break-all;\">{{actionUrl}}</a>\n</p>\n",
      "textBody": "Hi {{name}},\n\n{{organisation}} submitted proof of payment. Their plan changes only once it's approved.\n\nWorkspace: {{organisation}}\nPlan: {{planName}}\nAmount: {{amount}}\n\nReview it:\n{{actionUrl}}\n",
      "variables": [
        {
          "name": "name",
          "description": "Reviewer's name.",
          "sample": "Priya Raman"
        },
        {
          "name": "organisation",
          "description": "Workspace that submitted the payment.",
          "sample": "Northwind Retail"
        },
        {
          "name": "planName",
          "description": "Plan being paid for.",
          "sample": "Growth"
        },
        {
          "name": "amount",
          "description": "Amount and currency, already formatted.",
          "sample": "PKR 14,999"
        },
        {
          "name": "actionUrl",
          "description": "Link to the review screen.",
          "sample": "https://app.nextreach.io/superadmin/payments"
        }
      ]
    },
    {
      "key": "payments.approved",
      "name": "Payment approved",
      "description": "Sent to a workspace when its payment is confirmed and the plan is active.",
      "category": "payments",
      "subject": "Payment confirmed: {{planName}} is active",
      "htmlBody": "<h1 style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:22px;line-height:30px;font-weight:700;letter-spacing:-0.3px;color:#1e293b;\">\n  Your payment is confirmed\n</h1>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  Hi {{name}},\n</p>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:4px 0 24px 0;\">\n  <tr>\n    <td style=\"padding:14px 16px;background-color:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;color:#166534;\">\n      <strong>{{planName}}</strong> is now active on your workspace.\n    </td>\n  </tr>\n</table>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:4px 0 24px 0;background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;border-collapse:separate;\">\n  <tr>\n    <td style=\"padding:12px 16px;border-bottom:1px solid #e5e7eb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">Amount</td>\n    <td align=\"right\" style=\"padding:12px 16px;border-bottom:1px solid #e5e7eb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:600;color:#1e293b;\">{{amount}}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:12px 16px;border-bottom:1px solid #e5e7eb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">Plan</td>\n    <td align=\"right\" style=\"padding:12px 16px;border-bottom:1px solid #e5e7eb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:600;color:#1e293b;\">{{planName}}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:12px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">Active until</td>\n    <td align=\"right\" style=\"padding:12px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:600;color:#1e293b;\">{{activeUntil}}</td>\n  </tr>\n</table>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:8px 0 24px 0;\">\n  <tr>\n    <td align=\"center\" bgcolor=\"#16a34a\" style=\"border-radius:8px;background-color:#16a34a;\">\n      <a href=\"{{actionUrl}}\" target=\"_blank\" style=\"display:inline-block;padding:13px 26px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;\">View subscription</a>\n    </td>\n  </tr>\n</table>\n\n<p style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">\n  Button not working? Copy this link into your browser:<br>\n  <a href=\"{{actionUrl}}\" target=\"_blank\" style=\"color:#15803d;text-decoration:underline;word-break:break-all;\">{{actionUrl}}</a>\n</p>\n",
      "textBody": "Hi {{name}},\n\nYour payment is confirmed. {{planName}} is now active on your workspace.\n\nAmount: {{amount}}\nPlan: {{planName}}\nActive until: {{activeUntil}}\n\nView your subscription:\n{{actionUrl}}\n",
      "variables": [
        {
          "name": "name",
          "description": "Recipient's name.",
          "sample": "Ayesha Khan"
        },
        {
          "name": "amount",
          "description": "Amount and currency, already formatted.",
          "sample": "PKR 14,999"
        },
        {
          "name": "planName",
          "description": "Plan now active.",
          "sample": "Growth"
        },
        {
          "name": "activeUntil",
          "description": "When the plan runs until, already formatted.",
          "sample": "14 October 2026"
        },
        {
          "name": "actionUrl",
          "description": "Link to the subscription page.",
          "sample": "https://app.nextreach.io/subscription"
        }
      ]
    },
    {
      "key": "payments.rejected",
      "name": "Payment rejected",
      "description": "Sent to a workspace when its payment could not be confirmed.",
      "category": "payments",
      "subject": "We couldn't confirm your payment",
      "htmlBody": "<h1 style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:22px;line-height:30px;font-weight:700;letter-spacing:-0.3px;color:#1e293b;\">\n  We couldn't confirm your payment\n</h1>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  Hi {{name}},\n</p>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  Your payment for the <strong style=\"font-weight:600;color:#1e293b;\">{{planName}}</strong> plan wasn't approved, so your plan hasn't changed.\n</p>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:4px 0 24px 0;\">\n  <tr>\n    <td style=\"padding:14px 16px;background-color:#fef2f2;border:1px solid #fecaca;border-radius:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;color:#991b1b;\">\n      <strong>Reason given</strong><br>{{reason}}\n    </td>\n  </tr>\n</table>\n\n<p style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#475569;\">\n  You can submit the payment again with the details corrected.\n</p>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:8px 0 24px 0;\">\n  <tr>\n    <td align=\"center\" bgcolor=\"#16a34a\" style=\"border-radius:8px;background-color:#16a34a;\">\n      <a href=\"{{actionUrl}}\" target=\"_blank\" style=\"display:inline-block;padding:13px 26px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;\">Submit again</a>\n    </td>\n  </tr>\n</table>\n\n<p style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b7280;\">\n  Button not working? Copy this link into your browser:<br>\n  <a href=\"{{actionUrl}}\" target=\"_blank\" style=\"color:#15803d;text-decoration:underline;word-break:break-all;\">{{actionUrl}}</a>\n</p>\n",
      "textBody": "Hi {{name}},\n\nYour payment for the {{planName}} plan wasn't approved, so your plan hasn't changed.\n\nReason given:\n{{reason}}\n\nYou can submit the payment again with the details corrected:\n{{actionUrl}}\n",
      "variables": [
        {
          "name": "name",
          "description": "Recipient's name.",
          "sample": "Ayesha Khan"
        },
        {
          "name": "planName",
          "description": "Plan the payment was for.",
          "sample": "Growth"
        },
        {
          "name": "reason",
          "description": "Why it was rejected, as written by the reviewer.",
          "sample": "The transfer reference did not match any payment we received. Please upload the bank receipt."
        },
        {
          "name": "actionUrl",
          "description": "Link to try again.",
          "sample": "https://app.nextreach.io/pricing"
        }
      ]
    }
  ]
}
