<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Business layer, rules half: services, DTOs, validators and mappings.
    This is the only layer allowed to orchestrate repositories, transactions and integrations.
  -->
  <PropertyGroup>
    <RootNamespace>Marketing.Application</RootNamespace>
    <AssemblyName>Marketing.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marketing.Common\Marketing.Common.csproj" />
    <ProjectReference Include="..\Marketing.Shared\Marketing.Shared.csproj" />
    <ProjectReference Include="..\Marketing.Business\Marketing.Business.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rule helpers are internal on purpose - they are not part of the layer's contract -
         but their edge cases are exactly what needs covering, so the unit suite can see them. -->
    <InternalsVisibleTo Include="Marketing.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

</Project>
