<Project>

  <!--
    Solution-wide compiler and analysis settings.
    The target framework is declared here once so a framework upgrade is a single-line change.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      ICU is required, not optional. Country names are read from the runtime's own ISO 3166 data
      rather than from a table copied into this repository, and under invariant globalization that
      data is absent: RegionInfo hands back the code it was given, so "GB" renders as "GB".
      Deployment images must carry ICU - the standard .NET Linux images do; an Alpine image needs
      the icu-libs package.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      CS1591 (missing XML comment) stays a warning rather than an error so that a work-in-progress
      member never blocks the build; CI runs with /warnaserror to keep the tree clean.
    -->
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Company>Marketing Platform</Company>
    <Product>WhatsApp Marketing SaaS</Product>
    <Authors>Marketing Platform Engineering</Authors>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

</Project>
