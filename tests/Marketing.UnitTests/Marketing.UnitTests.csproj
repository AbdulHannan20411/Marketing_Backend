<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Marketing.UnitTests</RootNamespace>
    <AssemblyName>Marketing.UnitTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Marketing.Common\Marketing.Common.csproj" />
    <ProjectReference Include="..\..\src\Marketing.Shared\Marketing.Shared.csproj" />
    <ProjectReference Include="..\..\src\Marketing.DataAccess\Marketing.DataAccess.csproj" />
    <ProjectReference Include="..\..\src\Marketing.Business\Marketing.Business.csproj" />
    <ProjectReference Include="..\..\src\Marketing.Application\Marketing.Application.csproj" />
    <ProjectReference Include="..\..\src\Marketing.Infrastructure\Marketing.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit.v3 ships no implicit global usings, unlike the v2 package. -->
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
