# Copy to env.sh and fill in, then `source deploy/aws/env.sh` before deploy.sh.
#
# Nothing secret belongs in this file. Every value here is an identifier, an ARN
# or a hostname - the secrets themselves live in Secrets Manager and are named
# by SECRET_ARN below. env.sh is gitignored for belt and braces.

# ── Identity ─────────────────────────────────────────────────────────────────
export PROJECT=marketing
export AWS_REGION=eu-west-1
export AWS_ACCOUNT_ID=000000000000

# ── ECR ──────────────────────────────────────────────────────────────────────
# One repository holds both images; the migrate image is a separate tag.
export ECR_REPOSITORY="${PROJECT}-api"
export ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

# ── ECS ──────────────────────────────────────────────────────────────────────
export ECS_CLUSTER="${PROJECT}-cluster"
export ECS_API_SERVICE="${PROJECT}-api"
export ECS_WORKER_SERVICE="${PROJECT}-worker"

# Where the one-off migration task runs. Private subnets with a NAT route, or
# public subnets with ASSIGN_PUBLIC_IP=ENABLED - it needs to reach ECR, Secrets
# Manager and the database.
export SUBNET_IDS="subnet-aaaaaaaa,subnet-bbbbbbbb"
export SECURITY_GROUP_IDS="sg-cccccccc"
export ASSIGN_PUBLIC_IP=DISABLED

# ── IAM ──────────────────────────────────────────────────────────────────────
# Execution role: pulls the image, reads the secrets, writes the logs.
export EXECUTION_ROLE_ARN="arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT}-ecs-execution"

# Task role: what the application may do. S3 on the bucket prefix, nothing else.
export TASK_ROLE_ARN="arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT}-ecs-task"

# ── Secrets Manager ──────────────────────────────────────────────────────────
# One secret holding a JSON object. The task definitions pull individual keys
# out of it with the `:key::` suffix, so rotating one value is a single update
# and the values never appear in a task definition.
#
# Expected keys: DatabaseConnectionString, RedisConnectionString, RabbitHost,
# RabbitUsername, RabbitPassword, JwtSigningKey, WhatsAppAppSecret,
# WhatsAppWebhookVerifyToken, PlacesApiKey, SmtpPassword.
export SECRET_ARN="arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:${PROJECT}/app-XXXXXX"

# ── Application ──────────────────────────────────────────────────────────────
export S3_BUCKET="${PROJECT}-files"

# Prefix inside the bucket, so staging and production can share one bucket
# without being able to read each other's keys. Must not be empty - render.py
# treats an empty placeholder as unset, which is deliberate here.
export S3_PREFIX="production"

export CLIENT_BASE_URL="https://app.your-domain.com"
export JWT_ISSUER="https://api.your-domain.com"
export JWT_AUDIENCE="https://app.your-domain.com"

# ── Build ────────────────────────────────────────────────────────────────────
# Must match runtimePlatform.cpuArchitecture in the task definitions.
# linux/arm64 -> ARM64 (Graviton, cheaper). linux/amd64 -> X86_64.
export IMAGE_PLATFORM=linux/arm64
